# Kopieren nach .env.local und ausfüllen (Supabase → Project Settings → API).
# Beide Werte sind für den Browser gedacht und dürfen öffentlich sein –
# der Schutz der Daten liegt in den Row-Level-Security-Regeln der Datenbank.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NIEMALS hier eintragen: den service_role-Key. Der bleibt ausschließlich in Supabase.
